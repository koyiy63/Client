{
  "name": "yt-share-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server --ext js,json --exec \"node server/index.js\"",
    "dev:client": "vite --config client/vite.config.js",
    "build": "rimraf server/public && vite build --config client/vite.config.js && mkdir -p server/public && cp -r client/dist/* server/public/",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^9.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.41",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.3"
  }
}